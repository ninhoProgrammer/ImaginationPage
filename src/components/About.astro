<section id="about" class="h-screen grid grid-cols-2 items-center justify-end z-20 overflow-hidden px-10 md:px-0">

    <!-- IZQUIERDA -->
    <div class="animate-left w-8/12 text-(--color-primary) flex flex-col justify-start opacity-0 md:-translate-x-10 scale-75 transition-all duration-700 ease-out delay-200">

        <p class="text-xl 2xl:text-4xl pb-2 md:pb-0 font-light">
            About
        </p>

        <h1 class="text-2xl md:text-5xl xl:text-7xl font-bold mb-4 border-b border-(--color-secondary) pb-2">
            More About 
        </h1>
        
        <div class="bg-(--color-primary)/50 w-full text-(--color-background) p-4 rounded-lg shadow-lg z-50">
            <p class="text-xs md:text-sm xl:text-base 2xl:text-xl leading-relaxed">
                This is a section where you can share more about yourself, your passions, or your creative journey. Whether you're an artist, writer, or simply a dreamer.
            </p>
        </div>
    </div>

    <!-- DERECHA -->
    <div class="animate-right flex flex-row md:flex-col justify-end items-start md:items-end w-full opacity-0  md:scale-75 transition-all duration-700 ease-out delay-200">
        <div class="mt-10 md:grid grid-cols-1 space-y-8 md:grid-cols-1 gap-1">
            <img class="rounded-lg shadow-lg md:w-auto h-20 md:h-42 md:object-cover" src="../image2.webp" />
            <img class="rounded-lg shadow-lg md:w-auto h-20 md:h-42 md:object-cover" src="../image3.webp" />
        </div>

    </div>
    
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
    const aboutSection = document.querySelector('#about');

    // Verificamos que el elemento exista antes de hacer nada
    if (aboutSection) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if ( entry.isIntersecting) {
                    const left = entry.target.querySelector('.animate-left');
                    const right = entry.target.querySelector('.animate-right');

                    if(left) left.classList.add('scale-100', 'opacity-100', 'md:translate-x-10');
                    if(right) right.classList.add('scale-100', 'opacity-100', 'md:-translate-x-20');
                }
            });
        }, { threshold: 0.1 });

        observer.observe(aboutSection);
    } else {
        console.warn("No se encontró el ID #about en esta página.");
    }
});
</script>


