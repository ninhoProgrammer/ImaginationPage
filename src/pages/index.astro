---
import Layout from '../layouts/Layout.astro';
import Images from '../components/Images.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';	
import Contend from '../components/Contend.astro';
import Extra from '../components/Extra.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<main class="relative">
    <Images />

		<Hero />

		<About />
		
		<Contend />

    <Extra />

    <Section />

    <Footer />
		
	</main>
</Layout>

<script>
  window.addEventListener('load', () => {
    const image = document.getElementById('heroImage')
    const infoSection = document.getElementById('info')
   

    function updateImage() {
       if (!image || !infoSection) return

      const scrollY = window.scrollY

      const scale = 1 + scrollY * 0.0015
      const translateY = scrollY * 0.3

      const rect = infoSection.getBoundingClientRect()
      const windowHeight = window.innerHeight

      let opacity = 1

      if (rect.top < windowHeight) {
        const progress = 1 - rect.top / windowHeight
        opacity = 1 - progress
      }

      image.style.transform = `translateY(${translateY}px) scale(${scale})`
      image.style.opacity = Math.max(0, opacity).toString()
      image.style.zIndex = opacity > 0 ? '1' : '-1'
    }

    // 🔥 CORRE AL INICIO
    updateImage()

    // luego en scroll
    window.addEventListener('scroll', updateImage)
  })
</script>

